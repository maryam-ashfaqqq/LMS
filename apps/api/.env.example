PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# TiDB Cloud Serverless connection. The database named in DB_NAME is created if it does not exist.
DB_HOST=gateway.region.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=oakline
DB_SSL=true

# Created once, only if this email is not already in the users table.
# Quote the password when it contains # or spaces.
ADMIN_EMAIL=
ADMIN_PASSWORD=""

# Stripe test keys enable sandbox checkout. Leave blank until you are ready.
# Card details are never stored by this application.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
